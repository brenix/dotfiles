* {
    /* Base Colors */
    background:                  rgba(39,46,51, 95%);
    foreground:                  rgba(211,198,170, 100%);
    border-color:                rgba(92,106,114, 100%);
    
    /* Functional Colors */
    normal-background:           transparent;
    normal-foreground:           @foreground;
    
    /* Selection (Accent) */
    selected-normal-background:  rgba(127,187,179, 100%);
    selected-normal-foreground:  rgba(39,46,51, 100%);

    /* Alternate Rows (Set to transparent for a clean flat look) */
    alternate-normal-background: transparent;
    alternate-normal-foreground: @foreground;

    /* Urgent State (Usually Red) */
    urgent-background:           rgba(230,126,128, 100%);
    urgent-foreground:           rgba(211,198,170, 100%);
    selected-urgent-background:  rgba(248,85,82, 100%);
    
    /* Active State (Usually Green or Cyan) */
    active-background:           rgba(167,192,128, 100%);
    active-foreground:           rgba(39,46,51, 100%);
    selected-active-background:  rgba(141,161,1, 100%);

    /* Required for transparency to work correctly in Rofi */
    background-color:            transparent;
}
